{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "addLabels": [
        "{{manager}}",
    ],
    // The custom managers below read chorito's own source as data. Each one
    // matches a named constant in tools/MavenPluginVersions.java,
    // tools/MavenVersions.java or tools/JavaVersions.java -- never XML a chore
    // assembles -- so a rename or a reformat inside a chore cannot silently
    // stop an update. The second pattern in each manager keeps the test fixture
    // that asserts the written pom in step with the constant; the tests in
    // MavenPluginVersionsTest and EnforcerPluginChoreTest fail the build if the
    // two ever drift.
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "maven",
            "depNameTemplate": "net.revelc.code.formatter:formatter-maven-plugin",
            "managerFilePatterns": [
                "/^src/main/java/io/github/arlol/chorito/tools/MavenPluginVersions\\.java$/",
                "/^src/test/resources/io/github/arlol/chorito/eclipse-formatter-plugin/expected\\.xml$/",
            ],
            "matchStrings": [
                "FORMATTER = \"(?<currentValue>.*?)\"",
                "<groupId>net\\.revelc\\.code\\.formatter</groupId>\\s*<artifactId>formatter-maven-plugin</artifactId>\\s*<version>(?<currentValue>.*?)</version>",
            ],
        },
        {
            "customType": "regex",
            "datasourceTemplate": "maven",
            "depNameTemplate": "com.github.spotbugs:spotbugs-maven-plugin",
            "managerFilePatterns": [
                "/^src/main/java/io/github/arlol/chorito/tools/MavenPluginVersions\\.java$/",
                "/^src/test/resources/io/github/arlol/chorito/spotbugs-plugin/expected\\.xml$/",
            ],
            "matchStrings": [
                "SPOTBUGS = \"(?<currentValue>.*?)\"",
                "<groupId>com\\.github\\.spotbugs</groupId>\\s*<artifactId>spotbugs-maven-plugin</artifactId>\\s*<version>(?<currentValue>.*?)</version>",
            ],
        },
        {
            "customType": "regex",
            "datasourceTemplate": "maven",
            "depNameTemplate": "org.gaul:modernizer-maven-plugin",
            "managerFilePatterns": [
                "/^src/main/java/io/github/arlol/chorito/tools/MavenPluginVersions\\.java$/",
                "/^src/test/resources/io/github/arlol/chorito/modernizer-plugin/expected\\.xml$/",
            ],
            "matchStrings": [
                "MODERNIZER = \"(?<currentValue>.*?)\"",
                "<groupId>org\\.gaul</groupId>\\s*<artifactId>modernizer-maven-plugin</artifactId>\\s*<version>(?<currentValue>.*?)</version>",
            ],
        },
        {
            // The floor EnforcerPluginChore writes into every managed pom's
            // requireMavenVersion rule, and the one chorito's own build
            // enforces. Renovate's maven datasource skips the 4.0.0 release
            // candidates as unstable, so this tracks the latest final release.
            // The third file is chorito's own pom: the chore fixes it on the
            // next run, but only a run, and until then the repository would
            // enforce a floor its own constant has already moved past.
            "customType": "regex",
            "datasourceTemplate": "maven",
            "depNameTemplate": "org.apache.maven:apache-maven",
            "managerFilePatterns": [
                "/^src/main/java/io/github/arlol/chorito/tools/MavenVersions\\.java$/",
                "/^src/test/resources/io/github/arlol/chorito/enforcer-plugin/expected\\.xml$/",
                "/^pom\\.xml$/",
            ],
            "matchStrings": [
                "MAVEN = \"(?<currentValue>.*?)\"",
                "<requireMavenVersion>\\s*<version>(?<currentValue>.*?)</version>",
            ],
        },
        {
            "customType": "regex",
            "datasourceTemplate": "java-version",
            "depNameTemplate": "java",
            "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)",
            "managerFilePatterns": [
                "/^src/main/java/io/github/arlol/chorito/tools/JavaVersions\\.java$/",
                "/^src/test/resources/io/github/arlol/chorito/codeql/graal-expected\\.yaml$/",
            ],
            "matchStrings": [
                "TEMURIN = \"(?<currentValue>.*?)\"",
                "java-version: (?<currentValue>\\S+)",
            ],
        },
        {
            "customType": "regex",
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "graalvm/graalvm-ce-builds",
            "extractVersionTemplate": "^jdk-(?<version>\\S+)",
            "managerFilePatterns": [
                "/^\\.tool-versions$/",
            ],
            "matchStrings": [
                "java graalvm-community-(?<currentValue>\\S+)",
            ],
        },
        {
            "customType": "regex",
            "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)",
            "managerFilePatterns": [
                "/^\\.github/workflows/[^/]+\\.ya?ml$/",
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+java-version: (?<currentValue>\\S+)",
            ],
        },
    ],
    "extends": [
        "config:recommended",
    ],
    "labels": [
        "dependencies",
    ],
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            // CustomLinterRegistryBuilder lives in ec4j's own package so it can
            // subclass package-private types and call their constructors. ec4j
            // does not know that integration exists and is free to change those
            // members in any release, so its bumps are a decision rather than
            // routine: a signature change breaks the build loudly, but a
            // behavioural change behind an unchanged signature does not.
            // Ec4jChoreTest exercises the class end to end; read it, and the
            // upstream changelog, before merging one of these.
            "addLabels": [
                "review-custom-linter-registry",
            ],
            "matchPackageNames": [
                "org.ec4j.linters:{/,}**",
            ],
        },
    ],
    "schedule": [
        "on the 20th day of the month",
    ],
    "vulnerabilityAlerts": {
        "addLabels": [
            "security",
        ],
        "minimumReleaseAge": "0 days",
        "schedule": [
            "at any time",
        ],
    },
}
